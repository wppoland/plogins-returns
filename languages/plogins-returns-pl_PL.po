#. Plugin Name of the plugin
#: plogins-returns.php
msgid "Returns - Returns and RMA for WooCommerce"
msgstr "Returns - zwroty i RMA dla WooCommerce"

#. Plugin URI of the plugin
#: plogins-returns.php
msgid "https://plogins.com/plogins-returns/"
msgstr "https://plogins.com/plogins-returns/"

#. Description of the plugin
#: plogins-returns.php
msgid ""
"Let customers request returns, complaints and repairs (Right to Repair) from "
"their account and manage RMAs in the admin."
msgstr ""
"Pozwól klientom zgłaszać zwroty, reklamacje i naprawy (prawo do naprawy) z "
"poziomu konta, a zgłoszenia RMA obsługuj w panelu administracyjnym."

#. Author of the plugin
#: plogins-returns.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

