#. Plugin Name of the plugin
#: plogins-returns.php
msgid "Returns - Returns and RMA for WooCommerce"
msgstr "Returns - devoluciones y RMA para WooCommerce"

#. Plugin URI of the plugin
#: plogins-returns.php
msgid "https://plogins.com/plogins-returns/"
msgstr "https://plogins.com/plogins-returns/"

#. Description of the plugin
#: plogins-returns.php
msgid ""
"Let customers request returns, complaints and repairs (Right to Repair) from "
"their account and manage RMAs in the admin."
msgstr ""
"Permite que los clientes soliciten devoluciones, reclamaciones y "
"reparaciones (derecho a reparar) desde su cuenta y gestiona los RMA en el "
"administrador."

#. Author of the plugin
#: plogins-returns.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-returns.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#: plogins-returns.php:60
msgid ""
"Returns - Returns and RMA for WooCommerce requires WooCommerce to be active."
msgstr ""
"Returns - Returns and RMA for WooCommerce requiere que WooCommerce esté "
"activo."

